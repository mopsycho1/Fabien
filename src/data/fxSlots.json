  "steps": 3,
  "fadeFrom": 0.5,
  "fadeTo": 0.8
 },
 "walk": {
  "note": "The walking streaks: length = share of the streak's length kept (0.5 = half as long), alpha = how strong they are.",
  "length": 0.5,
  "alpha": 0.55
 },
 "fuse": {
  "note": "While a Verse lasts the figure gets a soft tint (a copy of the figure in the colour, added as light, tintAlpha) and a rim light (a slightly bigger copy behind it, rimAlpha, rimScale), both pulsing gently (pulse = how much of the strength is lost at the low point) with the loop. colours per Verse.",
